#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
set -e

# Force WM_PROJECT_USER_DIR (and the FOAM_USER_*BIN paths derived from it)
# to wherever this repository actually is, rather than relying on it
# already matching OpenFOAM's own $HOME/$WM_PROJECT/$USER-$WM_PROJECT_VERSION
# convention - a clone won't in general live at exactly that path, and the
# local username may differ from whichever machine it was developed on.
# Every Make/options in this repo resolves myIntermediate/myTurbulence
# headers via $(WM_PROJECT_USER_DIR), so getting this wrong either breaks
# the build outright (wmkdepend can't find e.g. BrownianMotionForce.H) or,
# worse, silently pulls headers from some other WM_PROJECT_USER_DIR left
# over on the machine.
export WM_PROJECT_USER_DIR="$PWD"
export FOAM_USER_APPBIN="$WM_PROJECT_USER_DIR/platforms/$WM_OPTIONS/bin"
export FOAM_USER_LIBBIN="$WM_PROJECT_USER_DIR/platforms/$WM_OPTIONS/lib"

# Libraries, in dependency order (myTurbulence links against myIntermediate;
# the two FvOptions libraries link against both)
wmake src/myIntermediate
wmake src/myTurbulence
wmake src/LogMoM
wmake src/flotation
wmake src/nuclear
wmake src/kinematicCloudFvOptions
wmake src/nuclearCloudFvOptions

# Solvers and utilities
wmake applications/solvers/nuclearParcelFoam
wmake applications/solvers/msfrParcelFoam
wmake applications/solvers/bubbleFoam
wmake applications/solvers/thermoParcelFoam
wmake applications/utilities/setLogNormal

#------------------------------------------------------------------------------
