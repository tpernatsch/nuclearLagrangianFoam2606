#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
set -e

# Points WM_PROJECT_USER_DIR/FOAM_USER_*BIN/PATH at this repository for the
# build - see etc/sourceme.sh for why this alone isn't enough for your
# interactive shell to find built solvers or build a single directory by
# hand afterwards (source etc/sourceme.sh for that).
. ./etc/sourceme.sh

# Libraries, in dependency order (myTurbulence links against myIntermediate;
# the two FvOptions libraries link against both)
wmake src/myIntermediate
wmake src/myTurbulence
wmake src/LogMoM
wmake src/flotation
wmake src/nuclear
wmake src/kinematicCloudFvOptions
wmake src/nuclearCloudFvOptions

# Solvers and utilities
wmake applications/solvers/nuclearParcelFoam
wmake applications/solvers/msfrParcelFoam
wmake applications/solvers/bubbleFoam
wmake applications/solvers/thermoParcelFoam
wmake applications/utilities/setLogNormal

echo
echo "Build complete. This only set up PATH for Allwmake's own subshell -"
echo "run 'source etc/sourceme.sh' in your own shell too (once per new"
echo "shell) so it can find the built solvers and build single directories"
echo "by hand."

#------------------------------------------------------------------------------
