FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;
    grad(U)             cellMDLimited Gauss linear 0.5;
    grad(alpha.liquid)  cellLimited Gauss linear 1;
    grad(alpha.gas)     cellLimited Gauss linear 1;
    /*grad(alpha.liquid)  Gauss linear; 
    grad(alpha.gas)     Gauss linear;*/
    grad(T)             Gauss linear;
}

divSchemes
{
    default         none;

    div(rhoPhi,U) Gauss linearUpwind grad(U);//Gauss upwind;

    "div\(phi,alpha.*\)"        Gauss interfaceCompression vanLeer 1; //Gauss vanLeer;
    "div\(phir,alpha.*\)"       Gauss linear;
    "div\(phirb,alpha.*\)"      Gauss linear;
    "div\(Yiphir,alpha.*\)"     Gauss upwind;
    "div\(phi,.*\.gas.*\)"      Gauss upwind;
    "div\(phi,.*\.liquid.*\)"   Gauss upwind;
    div(phiPhase_gas,xenon.gas)     Gauss upwind;
    div(phiPhase_liquid,xenon.liquid) Gauss upwind;

    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;

    div(phi,T)              Gauss linearUpwind gradST;

}

laplacianSchemes
{
    default         Gauss linear orthogonal;
}

interpolationSchemes
{
    default         linear;
}

/*snGradSchemes
{
    default         corrected;
}*/

snGradSchemes
{
    default             corrected;

    // These are the important ones for your case
    snGrad(rho)         corrected;
    snGrad(alpha.liquid) corrected;
    snGrad(alpha.gas)    corrected;
    snGrad(p_rgh)       corrected;
}

fluxRequired
{
    default     no;
    p_rgh;
    "alpha.*";
    "xenon.gas";
    "xenon.liquid";
}


