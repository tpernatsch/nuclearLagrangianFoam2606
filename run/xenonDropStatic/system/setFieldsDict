);
regions
(
    sphereToCell
    {
        centre (0 0 0.00045);
        radius 0.00015;//~0.3 mm sphere

        fieldValues
        (
            // VOF
            volScalarFieldValue alpha.liquid 1
            volScalarFieldValue alpha.gas    0

            // Species in liquid – this is the *actual* field name
            // Dilute reference 4e-8 (thesis 4e-5: gas near the drop reaches
            // Y_Xe 0.9 and leaves the dilute model; removal is linear in Y0)
            volScalarFieldValue xenon.liquid 4e-8
            volScalarFieldValue salt.liquid 0.99999996
            

            // velocity
            volVectorFieldValue U (0 0 0)
            //volScalarFieldValue p_rgh 8500
        );
    }
);


