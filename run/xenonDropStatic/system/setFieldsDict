FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    /*volScalarFieldValue alpha.gas       1//only air in the domain
    volScalarFieldValue alpha.liquid    0
