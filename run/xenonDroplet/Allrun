#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------
# Falling molten-salt droplet releasing xenon into helium (xenonTransferInterFoam).
# Needs the repo environment: source etc/sourceme.sh from the repository root.
# Options: -cubic (cubic-core mesh, system/blockMeshDict.cubic), -serial

meshDict=system/blockMeshDict
parallel=true

for arg in "$@"
do
    case "$arg" in
        -cubic)  meshDict=system/blockMeshDict.cubic ;;
        -serial) parallel=false ;;
        *) echo "Unknown option $arg (use -cubic, -serial)"; exit 1 ;;
    esac
done

runApplication blockMesh -dict "$meshDict"
runApplication checkMesh

restore0Dir
runApplication setFields

if [ "$parallel" = true ]
then
    runApplication decomposePar
    runParallel $(getApplication)
    runApplication reconstructPar -newTimes
else
    runApplication $(getApplication)
fi

#------------------------------------------------------------------------------
