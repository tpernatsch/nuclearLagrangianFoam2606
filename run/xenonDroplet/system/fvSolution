FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    ".*(rho|rhoFinal)"
    {
        solver          diagonal;
    }

    "alpha.*"
    {
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-10;
        relTol          0.0;

        // Alpha transport
        cAlphas         ((liquid and gas) 1);
        nAlphaCorr      2;
        nAlphaSubCycles 3;

        // Species transport
        nYiSubCycles    1;
        //cYi           0; Not supported yet

        alphaSpeciesMask both;
        
        cleanupGhostYi  true;
        alphaCleanupCut 1e-3;
        alphaSpeciesCut 1e-3;

        supportProjectBeforeSolve true;
        ZboundMassTol 1e-30;

        // Used only if addDiffusion true in the phase thermo dictionary
        alphaDiffMask   0.1;
        conserveFaceFluxY true;

        // Optional budget print
        budgetYi        false;
        budgetYiSpecies (xenon.liquid xenon.gas);

        // Mass-transfer source mapping / limiter
        interfaceAreaCut 0;

        alphaFaceSplit 0.5;
        alphaLo        0.05;
        alphaHi        0.95;

        alphaSourceMin 0.5;

        capToCell true;
        capacitySafetyFactor 0.5;
        donorSink       drop;     // liquid sink over the whole drop (needed by Newman)
        YminCap   0;
        YmaxCap   1;

        debugMassSpeciesTransfer false;
    }
    "U.*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-7;
        relTol          0;
    };

    "(T.*)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-08;
        relTol          0.0;
        residualAlpha   1e-7;
    }

    p_rgh
    {
        solver              GAMG;
        smoother            DICGaussSeidel;
        tolerance           1e-7;
        relTol              0.01;
        maxIter             100;

        nPreSweeps          1;
        nPostSweeps         2;
        nFinestSweeps       2;

        cacheAgglomeration  true;
        agglomerator        faceAreaPair;
        nCellsInCoarsestLevel 20;
        mergeLevels         1;
    }

    p_rghFinal
    {
        $p_rgh;
        tolerance           1e-8;
        relTol              0;
        maxIter             100;
    }

    "pcorr.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-5;
        relTol          0;
    }
    "(diffusion.*|helium.gas.*|xenon.gas.*|xenon.liquid.*)"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        tolerance       1e-12;
        relTol          0;
    }
}

PIMPLE
{
    correctPhi          false;
    momentumPredictor   false;
    nOuterCorrectors    2;
    nCorrectors         4;
    nNonOrthogonalCorrectors 1;

    pRefCell         0;
    pRefValue        5000;

    nCurvatureSmooth 0;     // curvature from alpha smoothed N times (0 = stock CSF)

}

relaxationFactors
{
    fields
    {
        p_rgh          0.3;
    }
    equations
    {
        ".*"            1;//"U.*"          0.7;
    }
}



