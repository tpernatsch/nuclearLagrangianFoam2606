
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setAlphaFieldDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Exact cut-cell sphere (Allrun -init smooth); same drop as setFieldsDict
field       alpha.gas;
type        sphere;
radius      0.00015;
origin      (0 0 0.0045);
invert      true;

// ************************************************************************* //
