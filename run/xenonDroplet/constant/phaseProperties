FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            diffusiveMassTransferMultiphaseSystem;

phases          (gas liquid);

gas
{
    type            diffusiveMultiComponentMovingPhaseModel;
    residualAlpha   1e-6;
}

liquid
{
    type            diffusiveMultiComponentMovingPhaseModel;
    residualAlpha   1e-6;
}

surfaceTension
(
    (gas and liquid)
    {
        type    constant;
        sigma   0.2617; //salt at 1017K by Yahima
    }
);


massTransferModel
(
    (liquid to gas)
    {
        type            gasDiffusionSimple;
        species         xenon.gas;

        C               1; //just a scaling factor for the mass transfer rate

        dispersedPhase  liquid;
        geometryVolumeFactor  1; //full geometry

        // ---------------- Interface detection / masking ----------------
        isoAlpha        0.5;
        alphaBandMin    1e-6;
        alphaLo         0.05;
        alphaHi         0.95;

        // ---------------- Bubble tracking ----------------
        alphaClusterCut 0.5;
        minDropCells    4;

        // ---------------- Diagnostics ----------------
        debugDeff       true;
        debugDrops      true;
        debugInternalCirculation   false;
        writeDropFields false;

        // ---------------- Equilibrium ----------------
        k               2.08e-4;

        // ---------------- Transport / Sherwood ----------------
        Dgas                  1e-5;
        Dliq                  2.006e-9;

        gasSherwoodModel      RanzMarshall;
        gasSherwood           2;

        liquidSherwoodModel   fixed;
        liquidSherwood        2; // for thesis I tested different values from 2 up to 100

        muGas           4.6913e-05;

        // ---------------- Characteristic diameter ----------------
        dpMode          perDropVA;
        dp              3.0e-4;     // used only if dpMode=fixed
    }//*/
);

// Minimum allowable pressure
pMin            1000;

