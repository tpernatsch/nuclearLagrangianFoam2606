# wmake build outputs (per-directory object files and dependency caches)
**/Make/linux64*/

# wmake's generated header symlink farms
**/lnInclude/

# top-level compiled binaries/libraries
platforms/

# editor/OS cruft
*.swp
.DS_Store

# Python bytecode cache
__pycache__/

# generated bubblyTube cases (recreate with run/bubblyTube/setupCase.py)
run/bubblyTube/cases/

# generated heatedPool cases (recreate with run/heatedPool/setupCase.py)
run/heatedPool/cases/

# xenon run queue results and logs (run/xenonQueue/runQueue.py)
run/xenonQueue/runs/
run/xenonQueue/queue.log
run/xenonQueue/queue.pid

# confidential material for heatedPool case C: everything stays out of git except the case inputs
# (C_inputs.py is tracked on purpose so setupCase.py can build case C on the cluster)
run/heatedPool/confidential/*
!run/heatedPool/confidential/C_inputs.py
